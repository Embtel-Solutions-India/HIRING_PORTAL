# Copy this file to .env on the server and fill in every value marked REQUIRED.
#   cp .env.example .env && nano .env
# Never commit or share the real .env — it holds passwords and keys.

# ---------------------------------------------------------------------------
# Your site
# ---------------------------------------------------------------------------
# REQUIRED. The address people will open (no https://, no trailing slash).
DOMAIN=hire.yourcompany.com
# REQUIRED. Same address with https://
APP_URL=https://hire.yourcompany.com
# Shown on the sign-in page, booking page and in emails.
ORG_NAME=Embtel Solutions
# Time zone for booking-link hours (list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
ORG_TIMEZONE=America/Los_Angeles

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# REQUIRED. Random secrets. Generate each with:  openssl rand -hex 32
APP_SECRET=
POSTGRES_PASSWORD=

# REQUIRED. Your own Google account email. You become Super Admin the first time you sign in.
SUPER_ADMIN_EMAIL=you@yourcompany.com
# Recommended. Only Google accounts on this domain can sign in.
ALLOWED_EMAIL_DOMAIN=yourcompany.com

# ---------------------------------------------------------------------------
# Database — optional. Leave these out to use the Postgres container in docker-compose.yml.
# To use a hosted Postgres (e.g. Supabase) instead, set both here AND remove the DATABASE_URL line under
# "app: environment:" in docker-compose.yml (it overrides this file).
# ---------------------------------------------------------------------------
# What the app connects with. Supabase: the transaction pooler (port 6543).
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# What migrations run with (needs a session connection). Supabase: the session pooler (port 5432).
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Google (sign-in, Drive, Calendar) — DEPLOY.md step 3
# ---------------------------------------------------------------------------
# REQUIRED
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only this account can connect/disconnect Google (Drive + Calendar). Default: admin@embtelsolutions.com
GOOGLE_OWNER_EMAIL=admin@embtelsolutions.com

# ---------------------------------------------------------------------------
# Email via any SMTP provider — DEPLOY.md step 4
# ---------------------------------------------------------------------------
# "smtp" to send real email. "log" only prints emails to the server log (handy while testing).
EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.yourprovider.com
# 587 (STARTTLS) works almost everywhere; 465 uses TLS from the start.
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Defaults for the sender (you can change these later in Settings → Email domain).
EMAIL_FROM_ADDRESS=careers@yourcompany.com
EMAIL_FROM_NAME=Talent Team
EMAIL_REPLY_TO=recruiting@yourcompany.com
# Stay at or below your provider's sending rate limit.
EMAIL_MAX_PER_SECOND=5

# ---------------------------------------------------------------------------
# AI resume summaries (Claude) — DEPLOY.md step 5. Optional but recommended.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Amazon S3 resume storage — DEPLOY.md "Amazon S3 (resume storage)". Optional.
# S3 becomes the main copy of every resume and Google Drive stays in sync.
# Leave AWS_REGION and S3_BUCKET empty to keep resumes in Google Drive only.
# The bucket must be private with Versioning turned on.
# ---------------------------------------------------------------------------
# e.g. ap-south-1
AWS_REGION=
S3_BUCKET=
# Optional — only if the server has no IAM role (not needed on EC2 with a role attached).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------
# How often to check Google Drive for new resumes (minutes).
DRIVE_SYNC_MINUTES=5
# Days a resume deleted in the portal or in Drive is kept before it is removed for good.
RESUME_DELETE_GRACE_DAYS=30

# ---------------------------------------------------------------------------
# Running without Docker — optional. The Docker image already sets these.
# ---------------------------------------------------------------------------
# NODE_ENV=production
# PORT=3000
# Where resumes are kept on disk when neither S3 nor Google Drive is set up.
# DATA_DIR=/data
# The built frontend (frontend/dist) the API serves.
# FRONTEND_DIST=/app/frontend/dist
